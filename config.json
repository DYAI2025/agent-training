{
  "agent_network": {
    "name": "WUPHF Agile Agent Network",
    "version": "1.0.0",
    "description": "Multi-agent orchestration system for AI-powered workflows"
  },
  "ceo_agent": {
    "name": "CEO/Orchestrator Agent",
    "class": "CEOOrchestratorAgent",
    "module": "agents.ceo_orchestrator_agent",
    "model": "nvidia/nemotron-120b",
    "api_provider": "openrouter",
    "api_url": "https://openrouter.ai/api/v1/chat/completions",
    "parameters": {
      "temperature": 0.3,
      "max_tokens": 1000
    },
    "capabilities": [
      "customer_request_analysis",
      "task_delegation",
      "true_north_qa_evaluation",
      "learning_integration",
      "strategic_planning"
    ],
    "environment_variables": {
      "openrouter_api_key": "OPENROUTER_API_KEY"
    }
  },
  "specialized_agents": {
    "content_agent": {
      "name": "Content Agent",
      "class": "ContentAgent",
      "module": "agents.content_agent",
      "model": "pitchdeck-2026:latest",
      "api_provider": "ollama",
      "parameters": {
        "temperature": 0.7,
        "num_predict": 2000
      },
      "capabilities": [
        "pitch_deck_creation",
        "content_improvement",
        "2026_best_practices_integration"
      ],
      "status": "implemented"
    },
    "research_agent": {
      "name": "Research Agent",
      "class": "ResearchAgent",
      "module": "agents.research_agent",
      "model": "qwen2.5:7b",
      "api_provider": "ollama",
      "parameters": {
        "temperature": 0.6,
        "num_predict": 1500
      },
      "capabilities": [
        "market_research",
        "competitor_analysis",
        "trend_identification",
        "customer_insights"
      ],
      "status": "implemented"
    },
    "analyst_agent": {
      "name": "Analyst Agent",
      "class": "AnalystAgent",
      "module": "agents.analyst_agent",
      "model": "gemma4:e4b",
      "api_provider": "ollama",
      "parameters": {
        "temperature": 0.4,
        "num_predict": 1500
      },
      "capabilities": [
        "quality_analysis",
        "data_analysis",
        "compliance_validation",
        "qa_report_generation"
      ],
      "status": "implemented"
    },
    "design_agent": {
      "name": "Design Agent",
      "class": "DesignAgent",
      "module": "agents.design_agent",
      "model": "llama3.2:latest",
      "api_provider": "ollama",
      "parameters": {
        "temperature": 0.8,
        "num_predict": 2000
      },
      "capabilities": [
        "visual_design",
        "pdf_generation",
        "accessibility_optimization",
        "brand_guidelines"
      ],
      "status": "implemented"
    }
  },
  "true_north_principles": {
    "alignment_with_mission": "Ensure all tasks align with organizational mission and values",
    "customer_value_creation": "Prioritize actions that create value for customers",
    "quality_and_excellence": "Maintain high quality standards in all deliverables",
    "innovation_and_continuous_improvement": "Encourage innovation and continuous learning"
  },
  "task_priorities": {
    "high": "Critical tasks requiring immediate attention",
    "medium": "Standard tasks with normal timeline",
    "low": "Tasks that can be deferred without impact"
  },
  "task_statuses": {
    "pending": "Task created but not started",
    "in_progress": "Task currently being executed",
    "completed": "Task successfully finished",
    "failed": "Task execution failed"
  },
  "learning": {
    "pattern_recognition": {
      "enabled": true,
      "min_history_size": 5
    },
    "adaptive_delegation": {
      "enabled": true,
      "confidence_threshold": 0.7
    }
  },
  "workflow": {
    "agile_orchestrator": {
      "class": "AgileOrchestrator",
      "module": "workflow.agile_orchestrator",
      "max_iterations": 3,
      "quality_threshold": 0.8,
      "phases": [
        "initialization",
        "research",
        "content_creation",
        "analysis",
        "design",
        "iteration",
        "finalization"
      ],
      "state_management": {
        "idle": "workflow_not_started",
        "running": "workflow_in_progress",
        "paused": "workflow_temporarily_suspended",
        "completed": "workflow_finished_successfully",
        "failed": "workflow_finished_with_errors"
      }
    }
  },
  "ollama": {
    "base_url": "http://localhost:11434",
    "timeout": 120,
    "allowed_local_models": [
      "pitchdeck-2026:latest",
      "qwen2.5:7b",
      "gemma4:e4b",
      "llama3.2:latest"
    ]
  }
}
